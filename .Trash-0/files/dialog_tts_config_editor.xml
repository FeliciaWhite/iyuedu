<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 启用开关 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="启用"
                android:textSize="14sp"
                android:textColor="@color/primaryText" />

            <CheckBox
                android:id="@+id/cb_enabled"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider"
            android:layout_marginBottom="12dp" />

        <!-- 标签类型 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="标签类型"
            android:textSize="12sp"
            android:textColor="@color/secondaryText" />

        <Spinner
            android:id="@+id/spinner_tag_type"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp" />

        <!-- 性别 (Timbre 标签时显示) -->
        <TextView
            android:id="@+id/tv_gender_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="性别"
            android:textSize="12sp"
            android:textColor="@color/secondaryText"
            android:visibility="gone" />

        <Spinner
            android:id="@+id/spinner_gender"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:visibility="gone" />

        <!-- 年龄 (Timbre 标签时显示) -->
        <TextView
            android:id="@+id/tv_age_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="年龄"
            android:textSize="12sp"
            android:textColor="@color/secondaryText"
            android:visibility="gone" />

        <Spinner
            android:id="@+id/spinner_age"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:visibility="gone" />

        <!-- 特征 (Timbre 标签时显示) -->
        <TextView
            android:id="@+id/tv_feature_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="特征"
            android:textSize="12sp"
            android:textColor="@color/secondaryText"
            android:visibility="gone" />

        <Spinner
            android:id="@+id/spinner_feature"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:visibility="gone" />

        <!-- 标签 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="标签 (voiceTag)"
            android:textSize="12sp"
            android:textColor="@color/secondaryText" />

        <EditText
            android:id="@+id/et_voice_tag"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="如: 旁白、括号1、男性青年/通用01"
            android:textSize="14sp"
            android:layout_marginBottom="8dp" />

        <!-- 显示名称 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="显示名称"
            android:textSize="12sp"
            android:textColor="@color/secondaryText" />

        <EditText
            android:id="@+id/et_display_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="如: 默认旁白"
            android:textSize="14sp"
            android:layout_marginBottom="8dp" />

        <!-- 分组 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="分组"
            android:textSize="12sp"
            android:textColor="@color/secondaryText" />

        <Spinner
            android:id="@+id/spinner_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp" />

        <!-- 子分组 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="子分组"
            android:textSize="12sp"
            android:textColor="@color/secondaryText" />

        <Spinner
            android:id="@+id/spinner_sub_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider"
            android:layout_marginBottom="12dp" />

        <!-- 插件选择 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="声音插件"
            android:textSize="12sp"
            android:textColor="@color/secondaryText" />

        <Spinner
            android:id="@+id/spinner_plugin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp" />

        <!-- 音色选择 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="音色 (voice)"
            android:textSize="12sp"
            android:textColor="@color/secondaryText" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <EditText
                android:id="@+id/et_voice"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="如: zh-CN-XiaoxiaoNeural"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btn_pick_voice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="选择"
                android:textSize="12sp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="8dp" />
        </LinearLayout>

        <!-- 语速 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="语速"
            android:textSize="12sp"
            android:textColor="@color/secondaryText" />

        <SeekBar
            android:id="@+id/seekbar_speed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="200"
            android:progress="100"
            android:layout_marginBottom="2dp" />

        <TextView
            android:id="@+id/tv_speed_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1.00"
            android:textSize="11sp"
            android:textColor="@color/secondaryText"
            android:layout_marginBottom="8dp" />

        <!-- 音量 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="音量"
            android:textSize="12sp"
            android:textColor="@color/secondaryText" />

        <SeekBar
            android:id="@+id/seekbar_volume"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="200"
            android:progress="100"
            android:layout_marginBottom="2dp" />

        <TextView
            android:id="@+id/tv_volume_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1.00"
            android:textSize="11sp"
            android:textColor="@color/secondaryText"
            android:layout_marginBottom="8dp" />

        <!-- 音调 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="音调"
            android:textSize="12sp"
            android:textColor="@color/secondaryText" />

        <SeekBar
            android:id="@+id/seekbar_pitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="200"
            android:progress="100"
            android:layout_marginBottom="2dp" />

        <TextView
            android:id="@+id/tv_pitch_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1.00"
            android:textSize="11sp"
            android:textColor="@color/secondaryText"
            android:layout_marginBottom="12dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider"
            android:layout_marginBottom="12dp" />

        <!-- URL 模板 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="URL 模板 (无插件时必填)"
            android:textSize="12sp"
            android:textColor="@color/secondaryText" />

        <EditText
            android:id="@+id/et_url"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="https://..."
            android:textSize="13sp"
            android:layout_marginBottom="8dp" />

        <!-- 请求方法 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="请求方法"
            android:textSize="12sp"
            android:textColor="@color/secondaryText" />

        <Spinner
            android:id="@+id/spinner_method"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp" />

        <!-- 请求头 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="请求头 (JSON)"
            android:textSize="12sp"
            android:textColor="@color/secondaryText" />

        <EditText
            android:id="@+id/et_headers"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint='{"Content-Type":"application/json"}'
            android:textSize="13sp"
            android:minLines="2"
            android:layout_marginBottom="8dp" />

        <!-- 请求体 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="请求体模板"
            android:textSize="12sp"
            android:textColor="@color/secondaryText" />

        <EditText
            android:id="@+id/et_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:minLines="2"
            android:layout_marginBottom="8dp" />

        <!-- 响应音频路径 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="响应音频路径"
            android:textSize="12sp"
            android:textColor="@color/secondaryText" />

        <EditText
            android:id="@+id/et_response_path"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="如: data.audio"
            android:textSize="13sp"
            android:layout_marginBottom="8dp" />

    </LinearLayout>
</ScrollView>
