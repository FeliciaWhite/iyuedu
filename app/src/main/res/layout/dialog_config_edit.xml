<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="编辑配置"
            android:textColor="@color/primaryText"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <!-- 显示名称 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="显示名称"
            android:textColor="@color/primaryText"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/et_display_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="请输入配置名称"
            android:textColor="@color/primaryText"
            android:textSize="14sp"
            android:layout_marginBottom="10dp" />

        <!-- 所属分组 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="所属分组"
            android:textColor="@color/primaryText"
            android:textSize="13sp" />

        <Spinner
            android:id="@+id/spinner_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_spinner"
            android:padding="8dp"
            android:layout_marginBottom="10dp" />

        <!-- 音色分类 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="选择音色分类"
            android:textColor="@color/primaryText"
            android:textSize="13sp" />

        <Spinner
            android:id="@+id/spinner_category"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_spinner"
            android:padding="8dp"
            android:layout_marginBottom="10dp" />

        <!-- 发音人 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="选择发音人"
            android:textColor="@color/primaryText"
            android:textSize="13sp" />

        <Spinner
            android:id="@+id/spinner_voice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_spinner"
            android:padding="8dp"
            android:layout_marginBottom="10dp" />

        <!-- 试听 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="试听"
            android:textColor="@color/primaryText"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="10dp">

            <EditText
                android:id="@+id/et_preview_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="输入试听文本"
                android:text="你好，这是一段试听语音"
                android:textColor="@color/primaryText"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btn_preview"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="试听" />
        </LinearLayout>

        <!-- 标签 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="选择标签"
            android:textColor="@color/primaryText"
            android:textSize="13sp" />

        <Spinner
            android:id="@+id/spinner_tag"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_spinner"
            android:padding="8dp"
            android:layout_marginBottom="10dp" />

        <!-- 高级音色预设 -->
        <LinearLayout
            android:id="@+id/ll_preset"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="选择高级音色预设提示词"
                android:textColor="@color/primaryText"
                android:textSize="13sp" />

            <Spinner
                android:id="@+id/spinner_preset"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_spinner"
                android:padding="8dp"
                android:layout_marginBottom="10dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="语音提示词（仅高级音色支持）"
                android:textColor="@color/primaryText"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/et_prompt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minLines="4"
                android:gravity="top"
                android:textColor="@color/primaryText"
                android:textSize="14sp"
                android:layout_marginBottom="10dp" />
        </LinearLayout>

        <!-- 情感音色情绪 -->
        <LinearLayout
            android:id="@+id/ll_emotion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="情绪选择（仅情感音色支持）"
                android:textColor="@color/primaryText"
                android:textSize="13sp" />

            <LinearLayout
                android:id="@+id/ll_emotion_check"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="10dp" />
        </LinearLayout>

        <!-- 采样率 语速 音量 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginEnd="4dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="采样率"
                    android:textColor="@color/primaryText"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/et_sample_rate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/primaryText"
                    android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginHorizontal="4dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="语速"
                    android:textColor="@color/primaryText"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/et_speed"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal"
                    android:textColor="@color/primaryText"
                    android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="4dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="音量"
                    android:textColor="@color/primaryText"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/et_volume"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal"
                    android:textColor="@color/primaryText"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
