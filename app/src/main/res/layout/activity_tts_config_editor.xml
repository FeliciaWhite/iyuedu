<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <io.legado.app.ui.widget.TitleBar
        android:id="@+id/title_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:contentInsetStartWithNavigation="0dp"
        app:title="编辑 TTS 配置" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- 卡片1: 基础信息 -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="8dp"
                app:cardElevation="2dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="基础信息" android:textSize="16sp" android:textStyle="bold"
                        android:textColor="@color/primaryText" android:layout_marginBottom="12dp" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="8dp">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:text="启用" android:textSize="14sp" />
                        <Switch android:id="@+id/sw_enabled" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="显示名称" android:textSize="12sp" android:textColor="@color/secondaryText" />
                    <EditText android:id="@+id/et_display_name" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:hint="如: 默认旁白"
                        android:textSize="14sp" android:layout_marginBottom="8dp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="标签 (voiceTag)" android:textSize="12sp" android:textColor="@color/secondaryText" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="4dp">
                        <EditText android:id="@+id/et_voice_tag" android:layout_width="0dp"
                            android:layout_height="wrap_content" android:layout_weight="1"
                            android:hint="如: 旁白、男性青年/通用01" android:textSize="14sp" />
                        <ImageView android:id="@+id/iv_tag_search" android:layout_width="36dp"
                            android:layout_height="36dp" android:padding="6dp"
                            android:src="@drawable/ic_search" android:background="?attr/selectableItemBackgroundBorderless" />
                    </LinearLayout>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="AI标签生成器" android:textSize="13sp" android:textStyle="bold"
                        android:textColor="@color/primaryText" android:layout_marginTop="4dp" android:layout_marginBottom="6dp" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:layout_marginBottom="4dp">
                        <Spinner android:id="@+id/spinner_gender" android:layout_width="0dp"
                            android:layout_height="wrap_content" android:layout_weight="1" />
                        <Spinner android:id="@+id/spinner_age" android:layout_width="0dp"
                            android:layout_height="wrap_content" android:layout_weight="1" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="4dp">
                        <EditText android:id="@+id/et_style" android:layout_width="0dp"
                            android:layout_height="wrap_content" android:layout_weight="1"
                            android:hint="风格 (如: 通用)" android:textSize="13sp" />
                        <EditText android:id="@+id/et_tag_number" android:layout_width="60dp"
                            android:layout_height="wrap_content" android:hint="01"
                            android:textSize="13sp" android:inputType="number" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:layout_marginBottom="8dp">
                        <Button android:id="@+id/btn_generate_tag" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:text="生成" android:textSize="12sp"
                            android:minWidth="0dp" android:minHeight="0dp" android:padding="8dp" />
                        <Button android:id="@+id/btn_recognize_tag" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:text="识别当前" android:textSize="12sp"
                            android:minWidth="0dp" android:minHeight="0dp" android:padding="8dp" android:layout_marginStart="8dp" />
                    </LinearLayout>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="一级分组" android:textSize="12sp" android:textColor="@color/secondaryText" />
                    <EditText android:id="@+id/et_group" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:hint="如: 默认分组"
                        android:textSize="14sp" android:layout_marginBottom="8dp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="二级分组" android:textSize="12sp" android:textColor="@color/secondaryText" />
                    <EditText android:id="@+id/et_sub_group" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:hint="如: 默认" android:textSize="14sp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- 卡片2: 插件声音（动态字段） -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="8dp"
                app:cardElevation="2dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="插件声音" android:textSize="16sp" android:textStyle="bold"
                        android:textColor="@color/primaryText" android:layout_marginBottom="12dp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="声音插件" android:textSize="12sp" android:textColor="@color/secondaryText" />
                    <Spinner android:id="@+id/spinner_plugin" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:layout_marginBottom="8dp" />
                    <!-- locale: 有插件code时显示Spinner，否则显示EditText -->
                    <TextView android:id="@+id/tv_locale_label" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="音色分类 (locale)"
                        android:textSize="12sp" android:textColor="@color/secondaryText" />
                    <Spinner android:id="@+id/spinner_locale" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:layout_marginBottom="8dp" />
                    <EditText android:id="@+id/et_locale" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:hint="如: zh-CN"
                        android:textSize="14sp" android:visibility="gone" android:layout_marginBottom="8dp" />
                    <!-- voice + 搜索 -->
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="音色 (voice)" android:textSize="12sp" android:textColor="@color/secondaryText" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="8dp">
                        <EditText android:id="@+id/et_voice" android:layout_width="0dp"
                            android:layout_height="wrap_content" android:layout_weight="1"
                            android:hint="选择或输入音色" android:textSize="14sp" />
                        <ImageView android:id="@+id/iv_voice_search" android:layout_width="36dp"
                            android:layout_height="36dp" android:padding="6dp"
                            android:src="@drawable/ic_search" android:background="?attr/selectableItemBackgroundBorderless" />
                    </LinearLayout>
                    <!-- 预设控制（动态显示） -->
                    <LinearLayout android:id="@+id/layout_preset" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:orientation="vertical"
                        android:visibility="gone" android:layout_marginTop="4dp">
                        <View android:layout_width="match_parent" android:layout_height="1dp"
                            android:background="@color/divider" android:layout_marginBottom="8dp" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="预设控制" android:textSize="14sp" android:textStyle="bold"
                            android:textColor="@color/primaryText" android:layout_marginBottom="6dp" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="预设" android:textSize="12sp" android:textColor="@color/secondaryText" />
                        <Spinner android:id="@+id/spinner_preset" android:layout_width="match_parent"
                            android:layout_height="wrap_content" android:layout_marginBottom="8dp" />
                        <TextView android:id="@+id/tv_manual_context_label" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:text="手动提示词"
                            android:textSize="12sp" android:textColor="@color/secondaryText" android:visibility="gone" />
                        <EditText android:id="@+id/et_manual_context" android:layout_width="match_parent"
                            android:layout_height="wrap_content" android:textSize="13sp"
                            android:minLines="3" android:visibility="gone" android:layout_marginBottom="8dp" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- 卡片3: 试听 -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="8dp"
                app:cardElevation="2dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="16dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="试听" android:textSize="16sp" android:textStyle="bold"
                        android:textColor="@color/primaryText" android:layout_marginBottom="12dp" />
                    <EditText android:id="@+id/et_preview_text" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:hint="输入试听文本..."
                        android:textSize="14sp" android:minLines="2" android:layout_marginBottom="8dp" />
                    <Button android:id="@+id/btn_preview" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="试听" android:textSize="12sp"
                        android:minWidth="0dp" android:minHeight="0dp" android:padding="8dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- 卡片4: 音频参数 -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="8dp"
                app:cardElevation="2dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="16dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="音频参数" android:textSize="16sp" android:textStyle="bold"
                        android:textColor="@color/primaryText" android:layout_marginBottom="12dp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="语速" android:textSize="12sp" android:textColor="@color/secondaryText" />
                    <SeekBar android:id="@+id/seekbar_speed" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:max="300" android:progress="100" />
                    <TextView android:id="@+id/tv_speed_value" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="1.00" android:textSize="11sp"
                        android:textColor="@color/secondaryText" android:layout_marginBottom="8dp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="音量" android:textSize="12sp" android:textColor="@color/secondaryText" />
                    <SeekBar android:id="@+id/seekbar_volume" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:max="300" android:progress="100" />
                    <TextView android:id="@+id/tv_volume_value" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="1.00" android:textSize="11sp"
                        android:textColor="@color/secondaryText" android:layout_marginBottom="8dp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="音调" android:textSize="12sp" android:textColor="@color/secondaryText" />
                    <SeekBar android:id="@+id/seekbar_pitch" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:max="300" android:progress="100" />
                    <TextView android:id="@+id/tv_pitch_value" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="1.00" android:textSize="11sp"
                        android:textColor="@color/secondaryText" android:layout_marginBottom="8dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- 卡片5: 直连设置 -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="8dp"
                app:cardElevation="2dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="16dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="直连设置 (无插件时使用)" android:textSize="16sp" android:textStyle="bold"
                        android:textColor="@color/primaryText" android:layout_marginBottom="12dp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="URL 模板" android:textSize="12sp" android:textColor="@color/secondaryText" />
                    <EditText android:id="@+id/et_url" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:hint="https://..."
                        android:textSize="13sp" android:layout_marginBottom="8dp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="请求方法" android:textSize="12sp" android:textColor="@color/secondaryText" />
                    <Spinner android:id="@+id/spinner_method" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:layout_marginBottom="8dp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="请求头 (JSON)" android:textSize="12sp" android:textColor="@color/secondaryText" />
                    <EditText android:id="@+id/et_headers" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:textSize="13sp"
                        android:minLines="2" android:layout_marginBottom="8dp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="请求体模板" android:textSize="12sp" android:textColor="@color/secondaryText" />
                    <EditText android:id="@+id/et_body" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:textSize="13sp"
                        android:minLines="2" android:layout_marginBottom="8dp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="响应音频路径" android:textSize="12sp" android:textColor="@color/secondaryText" />
                    <EditText android:id="@+id/et_response_path" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:hint="如: data.audio" android:textSize="13sp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
