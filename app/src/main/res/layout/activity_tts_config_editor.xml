<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <io.legado.app.ui.widget.TitleBar
        android:id="@+id/title_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:contentInsetStartWithNavigation="0dp"
        app:title="编辑 TTS 配置" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- 卡片1: 基础信息 -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="8dp"
                app:cardElevation="2dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="基础信息" android:textSize="16sp" android:textStyle="bold"
                        android:textColor="@color/primaryText" android:layout_marginBottom="12dp" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="8dp">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:text="启用" android:textSize="14sp" />
                        <Switch android:id="@+id/sw_enabled" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="显示名称" android:textSize="12sp" android:textColor="@color/secondaryText" />
                    <EditText android:id="@+id/et_display_name" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:hint="如: 默认旁白"
                        android:textSize="14sp" android:layout_marginBottom="8dp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="标签 (voiceTag)" android:textSize="12sp" android:textColor="@color/secondaryText" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="4dp">
                        <EditText android:id="@+id/et_voice_tag" android:layout_width="0dp"
                            android:layout_height="wrap_content" android:layout_weight="1"
                            android:hint="如: 旁白、男性青年/通用01" android:textSize="14sp" />
                        <ImageView android:id="@+id/iv_tag_search" android:layout_width="36dp"
                            android:layout_height="36dp" android:padding="6dp"
                            android:src="@drawable/ic_search" android:background="?attr/selectableItemBackgroundBorderless" />
                    </LinearLayout>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="AI标签生成器" android:textSize="13sp" android:textStyle="bold"
                        android:textColor="@color/primaryText" android:layout_marginTop="4dp" android:layout_marginBottom="6dp" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="4dp">
                        <Spinner android:id="@+id/spinner_gender" style="@style/SpinnerBorder"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content" android:layout_weight="0.8" />
                        <Spinner android:id="@+id/spinner_age" style="@style/SpinnerBorder"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content" android:layout_weight="1.2"
                            android:layout_marginStart="4dp" />
                        <EditText android:id="@+id/et_tag_number" android:layout_width="35dp"
                            android:layout_height="wrap_content" android:layout_marginStart="4dp"
                            android:hint="01"
                            android:textSize="13sp" android:inputType="number" />
                        <Button android:id="@+id/btn_generate_tag" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:layout_marginStart="4dp"
                            android:text="生成" android:textSize="12sp"
                            android:minWidth="0dp" android:minHeight="0dp" android:padding="8dp" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="8dp">
                        <EditText android:id="@+id/et_style" android:layout_width="0dp"
                            android:layout_height="wrap_content" android:layout_weight="1"
                            android:hint="风格 (如: 通用)" android:textSize="13sp" />
                    </LinearLayout>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="一级分组" android:textSize="12sp" android:textColor="@color/secondaryText" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="8dp">
                        <EditText android:id="@+id/et_group" android:layout_width="0dp"
                            android:layout_height="wrap_content" android:layout_weight="1"
                            android:hint="如: 默认分组" android:textSize="14sp" />
                        <ImageView android:id="@+id/iv_group_picker" android:layout_width="36dp"
                            android:layout_height="36dp" android:padding="6dp"
                            android:src="@drawable/ic_arrow_down" android:background="?attr/selectableItemBackgroundBorderless" />
                    </LinearLayout>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="二级分组" android:textSize="12sp" android:textColor="@color/secondaryText" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="8dp">
                        <EditText android:id="@+id/et_sub_group" android:layout_width="0dp"
                            android:layout_height="wrap_content" android:layout_weight="1"
                            android:hint="如: 默认" android:textSize="14sp" />
                        <ImageView android:id="@+id/iv_sub_group_picker" android:layout_width="36dp"
                            android:layout_height="36dp" android:padding="6dp"
                            android:src="@drawable/ic_arrow_down" android:background="?attr/selectableItemBackgroundBorderless" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- 卡片2: 插件声音（动态字段） -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="8dp"
                app:cardElevation="2dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="插件声音" android:textSize="16sp" android:textStyle="bold"
                        android:textColor="@color/primaryText" android:layout_marginBottom="12dp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="声音插件" android:textSize="12sp" android:textColor="@color/secondaryText" />
                    <Spinner android:id="@+id/spinner_plugin" style="@style/SpinnerBorder"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:layout_marginBottom="8dp" />
                    <!-- locale: 有插件code时显示Spinner，否则显示EditText -->
                    <TextView android:id="@+id/tv_locale_label" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="音色分类 (locale)"
                        android:textSize="12sp" android:textColor="@color/secondaryText" />
                    <Spinner android:id="@+id/spinner_locale" style="@style/SpinnerBorder"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:layout_marginBottom="8dp" />
                    <EditText android:id="@+id/et_locale" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:hint="如: zh-CN"
                        android:textSize="14sp" android:visibility="gone" android:layout_marginBottom="8dp" />
                    <!-- 试听（移至音色选择框上方，便于选好音色后直接试听） -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">
                        <EditText android:id="@+id/et_preview_text" android:layout_width="0dp"
                            android:layout_height="wrap_content" android:layout_weight="1"
                            android:hint="输入试听文本..." android:text="你好呀，你吃饭了吗？"
                            android:textSize="14sp" android:minLines="2" android:layout_marginEnd="8dp" />
                        <Button android:id="@+id/btn_preview" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:text="试听" android:textSize="12sp"
                            android:minWidth="0dp" android:minHeight="0dp" android:padding="8dp" />
                    </LinearLayout>
                    <!-- voice: 下拉选择框 -->
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="音色 (voice)" android:textSize="12sp" android:textColor="@color/secondaryText" />
                    <Spinner android:id="@+id/spinner_voice" style="@style/SpinnerBorder"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:layout_marginBottom="8dp" />

                    <!-- 插件自定义控件（动态渲染 onLoadUI 的控件树） -->
                    <LinearLayout android:id="@+id/layout_plugin_ui" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:orientation="vertical"
                        android:visibility="gone" android:layout_marginTop="4dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- 卡片4: 音频参数 -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="8dp"
                app:cardElevation="2dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="16dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="音频参数" android:textSize="16sp" android:textStyle="bold"
                        android:textColor="@color/primaryText" android:layout_marginBottom="12dp" />
                    <!-- 语速 -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center" android:layout_marginBottom="2dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="语速" android:textSize="13sp" android:textColor="@color/primaryText" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="  " android:textSize="13sp" />
                        <TextView android:id="@+id/tv_speed_value" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:text="1.00" android:textSize="13sp"
                            android:textColor="@color/primaryText" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="8dp">
                        <Button android:id="@+id/btn_speed_minus" android:layout_width="40dp" android:layout_height="36dp"
                            android:text="−" android:textSize="18sp" android:minWidth="0dp" android:minHeight="0dp" android:padding="0dp" />
                        <SeekBar android:id="@+id/seekbar_speed" android:layout_width="0dp"
                            android:layout_height="wrap_content" android:layout_weight="1" android:max="300" android:progress="100" />
                        <Button android:id="@+id/btn_speed_plus" android:layout_width="40dp" android:layout_height="36dp"
                            android:text="+" android:textSize="18sp" android:minWidth="0dp" android:minHeight="0dp" android:padding="0dp" />
                    </LinearLayout>
                    <!-- 音量 -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center" android:layout_marginBottom="2dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="音量" android:textSize="13sp" android:textColor="@color/primaryText" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="  " android:textSize="13sp" />
                        <TextView android:id="@+id/tv_volume_value" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:text="1.00" android:textSize="13sp"
                            android:textColor="@color/primaryText" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="8dp">
                        <Button android:id="@+id/btn_volume_minus" android:layout_width="40dp" android:layout_height="36dp"
                            android:text="−" android:textSize="18sp" android:minWidth="0dp" android:minHeight="0dp" android:padding="0dp" />
                        <SeekBar android:id="@+id/seekbar_volume" android:layout_width="0dp"
                            android:layout_height="wrap_content" android:layout_weight="1" android:max="300" android:progress="100" />
                        <Button android:id="@+id/btn_volume_plus" android:layout_width="40dp" android:layout_height="36dp"
                            android:text="+" android:textSize="18sp" android:minWidth="0dp" android:minHeight="0dp" android:padding="0dp" />
                    </LinearLayout>
                    <!-- 音调 -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center" android:layout_marginBottom="2dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="音调" android:textSize="13sp" android:textColor="@color/primaryText" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="  " android:textSize="13sp" />
                        <TextView android:id="@+id/tv_pitch_value" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:text="1.00" android:textSize="13sp"
                            android:textColor="@color/primaryText" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="8dp">
                        <Button android:id="@+id/btn_pitch_minus" android:layout_width="40dp" android:layout_height="36dp"
                            android:text="−" android:textSize="18sp" android:minWidth="0dp" android:minHeight="0dp" android:padding="0dp" />
                        <SeekBar android:id="@+id/seekbar_pitch" android:layout_width="0dp"
                            android:layout_height="wrap_content" android:layout_weight="1" android:max="300" android:progress="100" />
                        <Button android:id="@+id/btn_pitch_plus" android:layout_width="40dp" android:layout_height="36dp"
                            android:text="+" android:textSize="18sp" android:minWidth="0dp" android:minHeight="0dp" android:padding="0dp" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- 卡片5: 音频后处理调节（合成后生效） -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="8dp"
                app:cardElevation="2dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="16dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="音频后处理调节" android:textSize="16sp" android:textStyle="bold"
                        android:textColor="@color/primaryText" android:layout_marginBottom="4dp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="合成后转换时生效，0=跟随上级" android:textSize="11sp"
                        android:textColor="@color/secondaryText" android:layout_marginBottom="12dp" />
                    <!-- 后处理语速 -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center" android:layout_marginBottom="2dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="语速" android:textSize="13sp" android:textColor="@color/primaryText" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="  " android:textSize="13sp" />
                        <TextView android:id="@+id/tv_post_speed_value" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:text="跟随" android:textSize="13sp"
                            android:textColor="@color/primaryText" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="8dp">
                        <Button android:id="@+id/btn_post_speed_minus" android:layout_width="40dp" android:layout_height="36dp"
                            android:text="−" android:textSize="18sp" android:minWidth="0dp" android:minHeight="0dp" android:padding="0dp" />
                        <SeekBar android:id="@+id/seekbar_post_speed" android:layout_width="0dp"
                            android:layout_height="wrap_content" android:layout_weight="1" android:max="300" android:progress="0" />
                        <Button android:id="@+id/btn_post_speed_plus" android:layout_width="40dp" android:layout_height="36dp"
                            android:text="+" android:textSize="18sp" android:minWidth="0dp" android:minHeight="0dp" android:padding="0dp" />
                    </LinearLayout>
                    <!-- 后处理音量 -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center" android:layout_marginBottom="2dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="音量" android:textSize="13sp" android:textColor="@color/primaryText" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="  " android:textSize="13sp" />
                        <TextView android:id="@+id/tv_post_volume_value" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:text="跟随" android:textSize="13sp"
                            android:textColor="@color/primaryText" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="8dp">
                        <Button android:id="@+id/btn_post_volume_minus" android:layout_width="40dp" android:layout_height="36dp"
                            android:text="−" android:textSize="18sp" android:minWidth="0dp" android:minHeight="0dp" android:padding="0dp" />
                        <SeekBar android:id="@+id/seekbar_post_volume" android:layout_width="0dp"
                            android:layout_height="wrap_content" android:layout_weight="1" android:max="300" android:progress="0" />
                        <Button android:id="@+id/btn_post_volume_plus" android:layout_width="40dp" android:layout_height="36dp"
                            android:text="+" android:textSize="18sp" android:minWidth="0dp" android:minHeight="0dp" android:padding="0dp" />
                    </LinearLayout>
                    <!-- 后处理音高 -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center" android:layout_marginBottom="2dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="音高" android:textSize="13sp" android:textColor="@color/primaryText" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="  " android:textSize="13sp" />
                        <TextView android:id="@+id/tv_post_pitch_value" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:text="跟随" android:textSize="13sp"
                            android:textColor="@color/primaryText" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="8dp">
                        <Button android:id="@+id/btn_post_pitch_minus" android:layout_width="40dp" android:layout_height="36dp"
                            android:text="−" android:textSize="18sp" android:minWidth="0dp" android:minHeight="0dp" android:padding="0dp" />
                        <SeekBar android:id="@+id/seekbar_post_pitch" android:layout_width="0dp"
                            android:layout_height="wrap_content" android:layout_weight="1" android:max="300" android:progress="0" />
                        <Button android:id="@+id/btn_post_pitch_plus" android:layout_width="40dp" android:layout_height="36dp"
                            android:text="+" android:textSize="18sp" android:minWidth="0dp" android:minHeight="0dp" android:padding="0dp" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
